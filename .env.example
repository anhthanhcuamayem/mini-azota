[TEMPLATE]
# ------------------------------------------------------------------ Supabase
# Lấy trong Supabase Dashboard -> Project Settings -> API.
# Dùng service_role key vì server tự quản lý quyền (RLS bật + không policy).
SUPABASE_URL=https://ten-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Chạy supabase_schema.sql (SQL Editor) một lần để tạo bảng trước khi khởi động.

# ------------------------------------------------------------------ AI sinh đề
# Cấu hình AI sinh đề (chuẩn OpenAI-compatible: {AI_BASE_URL}/chat/completions)
# Ví dụ FreeLLMAPI: AI_BASE_URL=https://ten-domain-cua-ban/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# (Tùy chọn) Mật khẩu cho trang /admin - để trống = không yêu cầu mật khẩu
ADMIN_KEY=
